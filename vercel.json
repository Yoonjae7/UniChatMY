{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd client && npm install && npx vite build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install jsonwebtoken && npm install --save-dev @vercel/node @types/jsonwebtoken",
  "functions": {
    "api/*.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/auth/signup", "destination": "/api/signup" },
    { "source": "/api/auth/verify", "destination": "/api/verify" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
